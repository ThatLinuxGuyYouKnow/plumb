{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "bindings": [
        {
          "type": "service",
          "service": "convert",
          "format": "url",
          "env": "CONVERT_URL"
        }
      ]
    },
    "convert": {
      "root": "services/convert",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
