# Plumb server config (copy to .env — real env vars always take precedence).
# The key lives server-side only; it is never sent to the browser.

# Provider: anthropic (default), deepseek or nebius
PLUMB_PROVIDER=nebius

# One key for the chosen provider:
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# Nebius Token Factory key (https://tokenfactory.nebius.com/project/api-keys).
# NEBIUS_KEY is accepted as a legacy alias for local .env files.
NEBIUS_API_KEY=

# Optional: model override. Defaults: anthropic provider uses the API default,
# deepseek uses deepseek-chat, nebius uses nvidia/Nemotron-3_5-Lightning
# (fast text2text default; use nvidia/Nemotron-3.5-Super-VL for the slower
# multimodal model when the backend starts sending plan images).
# PLUMB_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional: proxy base URL overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional: ports (web dev 5197 proxies /api here; convert runs on 3102)
# PORT=3101
# CONVERT_URL=http://localhost:3102
